# ─────────────────────────────────────────────────────────────────────────────
# ELLA Square — master config template
# Copy to config.env, fill in your values, then run infra/scripts/deploy.sh
# ─────────────────────────────────────────────────────────────────────────────

# ── Deployment ─────────────────────────────────────────────────────────────────
ENV_NAME=dev                              # dev | staging | prod
RG_NAME=ella-square-rg
LOCATION=eastus                           # must support all resources below

# ── Azure OpenAI ───────────────────────────────────────────────────────────────
# Create in: Azure Portal → Cognitive Services → Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<name>.openai.azure.com
AZURE_OPENAI_API_KEY=<32-char-key>
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o             # deploy gpt-4o in AOAI Studio
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large

# ── Azure AI Search ────────────────────────────────────────────────────────────
# Create in: Azure Portal → Azure AI Search → Standard S1 tier minimum
# Enable semantic search (semantic ranker) in the resource settings
AZURE_SEARCH_ENDPOINT=https://<name>.search.windows.net
AZURE_SEARCH_API_KEY=<admin-key>
AZURE_SEARCH_INDEX_FINANCE=ella-finance   # created by setup-search-indexes.sh
AZURE_SEARCH_INDEX_HR=ella-hr
AZURE_SEARCH_INDEX_LEGAL=ella-legal

# ── Azure Content Safety ────────────────────────────────────────────────────────
# Create in: Azure Portal → Cognitive Services → Content Safety
AZURE_CONTENT_SAFETY_ENDPOINT=https://<name>.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=<key>

# ── Azure AI Language ───────────────────────────────────────────────────────────
# Create in: Azure Portal → Cognitive Services → Language
# Used for PII extraction and entity recognition in post-processing
AZURE_LANGUAGE_ENDPOINT=https://<name>.cognitiveservices.azure.com
AZURE_LANGUAGE_KEY=<key>

# ── Azure Storage ───────────────────────────────────────────────────────────────
# Storage account for document staging before indexing
# Containers ella-finance, ella-hr, ella-legal are created by Bicep
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<name>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_FINANCE=ella-finance
AZURE_STORAGE_CONTAINER_HR=ella-hr
AZURE_STORAGE_CONTAINER_LEGAL=ella-legal

# ── Bot Framework (Teams Bot) ────────────────────────────────────────────────────
# 1. Register an app in Azure AD: Portal → App Registrations → New
# 2. Add a client secret, save the value as BOT_APP_PASSWORD
# 3. In the Bot Channels Registration, set Messaging Endpoint to:
#    https://<func-hostname>/api/messages
BOT_APP_ID=<aad-app-id-guid>
BOT_APP_PASSWORD=<client-secret>
BOT_TENANT_ID=<aad-tenant-id>

# Map Teams channel IDs to domain IDs (JSON string)
# Get channel IDs from Teams Admin Centre or Teams Graph API
TEAM_DOMAIN_MAP='{"19:abc123@thread.tacv2":"finance","19:def456@thread.tacv2":"hr","default":"finance"}'

# ── Teams App ──────────────────────────────────────────────────────────────────
# Create a new App ID (any GUID) for the Teams manifest
# Register it in Azure AD for SSO (webApplicationInfo in manifest)
TEAMS_APP_ID=<new-guid>

# ── Azure Static Web Apps ─────────────────────────────────────────────────────
# Deployment token from: SWA resource → Manage deployment token
SWA_DEPLOYMENT_TOKEN=<token>

# ── Microsoft Purview (optional) ──────────────────────────────────────────────
# Enable sensitivity label enforcement for Confidential / Internal files
# Configure in: Microsoft Purview Compliance Portal → Information Protection
# Set PURVIEW_ENABLED=true to activate label-based access filtering in retrieval
PURVIEW_ENABLED=false
PURVIEW_TENANT_ID=<aad-tenant-id>

# ── Application Insights ───────────────────────────────────────────────────────
# Created automatically by Bicep — paste connection string here for local dev
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;...

# ── CORS ────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the API
ALLOWED_ORIGINS=https://<swa-hostname>.azurestaticapps.net,https://teams.microsoft.com
