{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "{{TEAMS_APP_ID}}",
  "packageName": "com.yourorg.ellasquare",
  "developer": {
    "name": "Your Organisation",
    "websiteUrl": "https://{{SWA_HOSTNAME}}",
    "privacyUrl": "https://{{SWA_HOSTNAME}}/privacy",
    "termsOfUseUrl": "https://{{SWA_HOSTNAME}}/terms"
  },
  "name": {
    "short": "ELLA Square",
    "full": "ELLA Square — Enterprise AI Assistant"
  },
  "description": {
    "short": "Domain-scoped enterprise RAG assistant",
    "full": "Ask questions across your organisation's knowledge bases — Finance, HR, Legal and more — with Azure AI-powered retrieval, content safety, and Teams-native experience."
  },
  "icons": {
    "color": "assets/color.png",
    "outline": "assets/outline.png"
  },
  "accentColor": "#107C10",
  "bots": [
    {
      "botId": "{{BOT_APP_ID}}",
      "scopes": ["team", "groupchat"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["team", "groupchat"],
          "commands": [
            {
              "title": "help",
              "description": "Show ELLA Square usage guide"
            }
          ]
        }
      ]
    }
  ],
  "configurableTabs": [
    {
      "configurationUrl": "https://{{SWA_HOSTNAME}}/?tab=channel&config=1",
      "canUpdateConfiguration": true,
      "scopes": ["team", "groupchat"],
      "sharePointPreviewImage": "assets/color.png",
      "supportedSharePointHosts": ["sharePointFullPage"]
    }
  ],
  "staticTabs": [
    {
      "entityId": "ella-chat",
      "name": "ELLA Square",
      "contentUrl": "https://{{SWA_HOSTNAME}}/?tab=personal",
      "websiteUrl": "https://{{SWA_HOSTNAME}}/?tab=personal",
      "scopes": ["personal"]
    },
    {
      "entityId": "ella-my-domains",
      "name": "My domains",
      "contentUrl": "https://{{SWA_HOSTNAME}}/?tab=personal&page=domains",
      "websiteUrl": "https://{{SWA_HOSTNAME}}/?tab=personal&page=domains",
      "scopes": ["personal"]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["{{SWA_HOSTNAME}}", "*.teams.microsoft.com"],
  "webApplicationInfo": {
    "id": "{{TEAMS_APP_ID}}",
    "resource": "api://{{SWA_HOSTNAME}}/{{TEAMS_APP_ID}}"
  }
}
