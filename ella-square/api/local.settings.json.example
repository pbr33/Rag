{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",

    "APPLICATIONINSIGHTS_CONNECTION_STRING": "InstrumentationKey=<your-key>;...",

    "AZURE_OPENAI_ENDPOINT":    "https://<your-aoai-name>.openai.azure.com",
    "AZURE_OPENAI_API_KEY":     "<your-aoai-key>",
    "AZURE_OPENAI_CHAT_DEPLOYMENT":    "gpt-4o",
    "AZURE_OPENAI_EMBED_DEPLOYMENT":   "text-embedding-3-large",

    "AZURE_SEARCH_ENDPOINT":    "https://<your-search-name>.search.windows.net",
    "AZURE_SEARCH_API_KEY":     "<your-search-admin-key>",
    "AZURE_SEARCH_INDEX_FINANCE": "ella-finance",
    "AZURE_SEARCH_INDEX_HR":      "ella-hr",
    "AZURE_SEARCH_INDEX_LEGAL":   "ella-legal",

    "AZURE_CONTENT_SAFETY_ENDPOINT": "https://<your-cs-name>.cognitiveservices.azure.com",
    "AZURE_CONTENT_SAFETY_KEY":      "<your-cs-key>",

    "AZURE_STORAGE_CONNECTION_STRING": "DefaultEndpointsProtocol=https;AccountName=<name>;AccountKey=<key>;EndpointSuffix=core.windows.net",
    "AZURE_STORAGE_CONTAINER_FINANCE": "ella-finance",
    "AZURE_STORAGE_CONTAINER_HR":      "ella-hr",
    "AZURE_STORAGE_CONTAINER_LEGAL":   "ella-legal",

    "AZURE_LANGUAGE_ENDPOINT": "https://<your-lang-name>.cognitiveservices.azure.com",
    "AZURE_LANGUAGE_KEY":      "<your-lang-key>",

    "BOT_APP_ID":       "<teams-bot-app-id>",
    "BOT_APP_PASSWORD": "<teams-bot-app-password>",
    "BOT_TENANT_ID":    "<your-aad-tenant-id>",

    "TEAMS_APP_ID": "<teams-app-manifest-app-id>",

    "ALLOWED_ORIGINS": "https://<your-swa-name>.azurestaticapps.net,https://teams.microsoft.com"
  }
}
