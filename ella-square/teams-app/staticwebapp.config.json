{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/api/*"]
  },
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "globalHeaders": {
    "content-security-policy": "default-src 'self' https://*.teams.microsoft.com https://*.microsoft.com; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
  }
}
